          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const responseJson = pm.response.json();",
                  "    pm.collectionVariables.set('property_id', responseJson.id);",
                  "    pm.test('Property created successfully', function () {",
                  "        pm.expect(responseJson).to.have.property('id');",
                  "        pm.expect(responseJson).to.have.property('date_created');",
                  "        pm.expect(responseJson).to.have.property('date_last_updated');",
                  "        pm.expect(responseJson.first_line_address).to.eql('123 Main Street');",
                  "    });",
                  "}"
